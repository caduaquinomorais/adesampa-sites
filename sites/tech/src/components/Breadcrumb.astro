---
/* Trilha "Início / Programas / Sampa Tech". O último item sem link é a página atual. */
interface Props {
  itens: { rotulo: string; href?: string }[];
}
const { itens } = Astro.props;
---
<nav class="breadcrumb" aria-label="Você está em">
    <ol>
        {itens.map((item) => (
            <li>{item.href ? <a href={item.href}>{item.rotulo}</a> : item.href === undefined && item === itens.at(-1) ? <span aria-current="page">{item.rotulo}</span> : <span>{item.rotulo}</span>}</li>
        ))}
    </ol>
</nav>
