---
/*
 * Ícones em linha (SVG na própria página, com a cor do texto: currentColor).
 * PROVISÓRIOS: desenhados à mão no estilo dos ícones do Figma, porque a API do Figma estava no limite
 * de uso. Trocar pelos SVGs exportados do Figma quando chegarem (pendência P-T6 em docs/DECISOES_TECH.md).
 */
interface Props {
  nome: 'check' | 'dinheiro' | 'formacao' | 'mentoria' | 'rede';
  tamanho?: number;
  classe?: string;
}
const { nome, tamanho = 40, classe } = Astro.props;
---
<svg class={classe} viewBox="0 0 40 40" width={tamanho} height={tamanho} aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    {nome === 'check' && <><circle cx="20" cy="20" r="18" fill="currentColor" stroke="none" /><path d="M12 20.5l5.5 5.5L28 15" stroke="#fff" stroke-width="4" /></>}
    {nome === 'dinheiro' && <><circle cx="20" cy="20" r="15" /><path d="M20 10v20M25 15.5c-.8-1.6-2.6-2.5-5-2.5-3 0-5 1.5-5 3.6 0 5 10 2.6 10 7.6 0 2.1-2 3.8-5 3.8-2.6 0-4.5-1-5.3-2.8" /></>}
    {nome === 'formacao' && <><path d="M4 15l16-7 16 7-16 7-16-7z" /><path d="M10 18v8c0 2.5 4.5 5 10 5s10-2.5 10-5v-8M36 15v10" /></>}
    {nome === 'mentoria' && <><circle cx="18" cy="18" r="11" /><path d="M26 26l9 9" /></>}
    {nome === 'rede' && <><circle cx="15" cy="15" r="6" /><path d="M4 33c1.5-6 6-9 11-9s9.5 3 11 9" /><path d="M24 9.5a6 6 0 1 1 3 11.3M29 24c3.5.8 6 3.5 7 9" /></>}
</svg>
