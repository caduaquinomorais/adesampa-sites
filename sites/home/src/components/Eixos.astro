---
/*
 * "Nossos eixos de atuação": os 5 programas (Início e Sobre).
 * Cada card tem 2 camadas: a imagem colorida do Figma (sempre) e, por cima, a versão branca do hover
 * (logo, texto e botão "Saiba mais"), que aparece ao passar o mouse ou com foco pelo teclado, só no
 * computador (decisão H-17). No celular e no tablet fica só o card colorido.
 * Textos: src/content/eixos.yaml. Cores dos botões: .eixo-card--<id> em styles/site.css.
 */
import { getCollection } from 'astro:content';
import { attrs } from '../lib/conteudo';
import { ambienteAtual, pagina, resolverDestino } from '@adesampa/ui/institucional';
import empreende from '../assets/eixos/eixo-empreende.svg?url';
import tech from '../assets/eixos/eixo-tech.svg?url';
import games from '../assets/eixos/eixo-games.svg?url';
import verde from '../assets/eixos/eixo-verde.svg?url';
import criativa from '../assets/eixos/eixo-criativa.svg?url';
// Logos de duas linhas (os mesmos do Menu de projetos, do pacote compartilhado).
import logoEmpreende from '@adesampa/ui/assets/icons/menu-empreende.svg?url';
import logoTech from '@adesampa/ui/assets/icons/menu-tech.svg?url';
import logoGames from '@adesampa/ui/assets/icons/menu-games.svg?url';
import logoVerde from '@adesampa/ui/assets/icons/menu-verde.svg?url';
import logoCriativa from '@adesampa/ui/assets/icons/menu-criativa.svg?url';

interface Props {
  titulo: string;
  texto?: string;
  fundo?: 'clara' | 'branca';
}
const { titulo, texto, fundo = 'clara' } = Astro.props;

// Quando os sites dos programas existirem, troque '' por resolverDestino(pagina('<site>'), ambiente).
const ambiente = ambienteAtual();
const VISUAL = {
  empreende: { img: empreende, logo: logoEmpreende, largura: 96, link: '' }, // TODO-LINK: site Sampa Empreende
  tech: { img: tech, logo: logoTech, largura: 77, link: resolverDestino(pagina('tech'), ambiente) },
  games: { img: games, logo: logoGames, largura: 75, link: '' }, // TODO-LINK
  verde: { img: verde, logo: logoVerde, largura: 76, link: '' }, // TODO-LINK
  criativa: { img: criativa, logo: logoCriativa, largura: 76, link: '' }, // TODO-LINK
} as const;
// Ordem da tela = ordem de VISUAL (Empreende, Tech, Games, Verde, Criativa), como no Figma.
const ORDEM = Object.keys(VISUAL);
const eixos = (await getCollection('eixos'))
  .filter((e) => e.id in VISUAL)
  .sort((a, b) => ORDEM.indexOf(a.id) - ORDEM.indexOf(b.id)) as { id: keyof typeof VISUAL; data: { nome: string; texto: string; botao: string } }[];
---
<section class:list={['secao eixos', fundo === 'clara' ? 'secao--clara' : 'secao--branca-borda']} aria-labelledby="titulo-eixos">
    <div class="container">
        <div class="cabecalho-centro">
            <h2 id="titulo-eixos" class="h-secao">{titulo}</h2>
            {texto && <p class="texto-1 quebras">{texto}</p>}
        </div>
        <ul class="eixos__lista">
            {eixos.map(({ id, data }) => (
                <li class:list={['eixo-card', `eixo-card--${id}`]}>
                    <a class="eixo-card__link" {...attrs(VISUAL[id].link)}>
                        <img class="eixo-card__img" src={VISUAL[id].img} alt={`${data.nome}: ${data.texto}`} width="206" height="234" loading="lazy">
                        {/* Versão do hover: só visual (o nome e o texto já estão no alt da imagem). */}
                        <span class="eixo-card__hover" aria-hidden="true">
                            <img class="eixo-card__logo" src={VISUAL[id].logo} alt="" width={Math.round(VISUAL[id].largura * 40 / 28)} height="40" loading="lazy">
                            <span class="eixo-card__texto">{data.texto}</span>
                            <span class="eixo-card__botao">{data.botao}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</section>
